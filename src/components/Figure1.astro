---
// Fig. 1: a line drawing that gains one layer per level. Coordinates are
// computed from the real angles (tilt 23.44°, 50°N noon elevations), then
// drawn schematically. Paths use pathLength=1 so they can draw themselves in.
const T = (23.44 * Math.PI) / 180;
const r2 = (n: number) => Math.round(n * 100) / 100;
const pt = (cx: number, cy: number, deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return `${r2(cx + r * Math.cos(a))} ${r2(cy - r * Math.sin(a))}`;
};
const arc = (cx: number, cy: number, r: number, from: number, to: number) =>
  `M${pt(cx, cy, from, r)} A${r} ${r} 0 0 ${to > from ? 0 : 1} ${pt(cx, cy, to, r)}`;

// Earths and axis (top leans toward +x in both positions)
const J = { x: 52, y: 80 }, D = { x: 328, y: 80 }, SUN = { x: 192, y: 80 };
const ax = (c: { x: number; y: number }) =>
  `M${r2(c.x - 30 * Math.sin(T))} ${r2(c.y + 30 * Math.cos(T))} L${r2(c.x + 30 * Math.sin(T))} ${r2(c.y - 30 * Math.cos(T))}`;

// Layer 3: equal beams at 50°N noon. Elevation = 90 − 50 ± 23.44
const beam = (hitX: number, elevDeg: number, len: number, width = 16) => {
  const e = (elevDeg * Math.PI) / 180;
  const foot = width / Math.sin(e);
  const a = hitX - foot / 2, b = hitX + foot / 2, g = 236;
  const dx = len * Math.cos(e), dy = len * Math.sin(e);
  return {
    beams: `M${r2(a)} ${g} L${r2(a + dx)} ${r2(g - dy)} M${r2(b)} ${g} L${r2(b + dx)} ${r2(g - dy)}`,
    bracket: `M${r2(a)} ${g + 5} V${g + 9} H${r2(b)} V${g + 5}`,
  };
};
const june = beam(86, 63.44, 54);
const dec = beam(258, 16.56, 82);

// Layer 4: angles on the June Earth. Equator right side sits at −23.44°.
const eqR = -23.44, eqL = 180 - 23.44, obs = eqL - 50; // observer at 50°N on the far side
const equator = `M${pt(J.x, J.y, eqL, 34)} L${pt(J.x, J.y, eqR, 34)}`;
const sunRay = `M${J.x} ${J.y} L${J.x + 70} ${J.y}`;
const obsRay = `M${J.x} ${J.y} L${pt(J.x, J.y, obs, 27)}`;
const deltaArc = arc(J.x, J.y, 27, 0, eqR);
const phiArc = arc(J.x, J.y, 24, eqL, obs);
const epsArc = arc(J.x, J.y, 28, 90, 90 - 23.44);
const normal = `M${J.x} ${J.y} V${J.y - 36}`; // perpendicular to the orbit plane

// Layer 5: strip chart, one year. Insolation peaks at the June solstice (day 172).
const X0 = 24, X1 = 364, YB = 312, YM = 292;
const xOf = (day: number) => X0 + ((X1 - X0) * day) / 365;
const curve = (peakDay: number, amp: number) => {
  const pts: string[] = [];
  for (let d = 0; d <= 365; d += 365 / 48) {
    const y = YM - amp * Math.cos((2 * Math.PI * (d - peakDay)) / 365);
    pts.push(`${r2(xOf(d))} ${r2(y)}`);
  }
  return `M${pts.join(' L')}`;
};
const months = 'JFMAMJJASOND'.split('');
---

<svg class="fig1-svg" viewBox="0 0 380 372" aria-hidden="true" focusable="false">
  <!-- layer 2 sits behind layer 1 so the Earths cover the orbit line -->
  <g data-layer="2">
    <ellipse class="d" cx="190" cy="80" rx="138" ry="30" pathLength="1" />
    <text x="4" y="18">farthest, early July</text>
    <text x="4" y="32" class="num">152.1 million km</text>
    <text x="376" y="18" text-anchor="end">nearest, early January</text>
    <text x="376" y="32" text-anchor="end" class="num">147.1 million km</text>
  </g>

  <g data-layer="1">
    <circle class="d body" cx={SUN.x} cy={SUN.y} r="15" pathLength="1" />
    <circle class="d body" cx={J.x} cy={J.y} r="19" pathLength="1" />
    <circle class="d body" cx={D.x} cy={D.y} r="19" pathLength="1" />
    <path class="d" d={ax(J)} pathLength="1" />
    <path class="d" d={ax(D)} pathLength="1" />
    <text x={SUN.x + 21} y={SUN.y + 4}>Sun</text>
    <text x={J.x} y="133" text-anchor="middle">June solstice</text>
    <text x={D.x} y="133" text-anchor="middle">December solstice</text>
  </g>

  <g data-layer="3">
    <path class="d" d="M20 236 H170 M206 236 H360" pathLength="1" />
    <path class="d" d={june.beams} pathLength="1" />
    <path class="d" d={dec.beams} pathLength="1" />
    <path class="d thin" d={june.bracket} pathLength="1" />
    <path class="d thin" d={dec.bracket} pathLength="1" />
    <text x="20" y="166">June, 50°N: steep beam</text>
    <text x="206" y="166">December, 50°N: low beam</text>
    <text x="20" y="262" class="num">≈16 h of daylight</text>
    <text x="206" y="262" class="num">≈8 h of daylight</text>
  </g>

  <g data-layer="4">
    <path class="d dash" d={equator} />
    <path class="d" d={sunRay} pathLength="1" />
    <path class="d" d={obsRay} pathLength="1" />
    <path class="d thin" d={deltaArc} pathLength="1" />
    <path class="d thin" d={phiArc} pathLength="1" />
    <path class="d thin" d={epsArc} pathLength="1" />
    <path class="d thin dash" d={normal} />
    <text x="98" y="97" class="greek">δ</text>
    <text x="14" y="58" class="greek">φ</text>
    <text x="64" y="46" class="greek">ε</text>
    <text x="75" y="46" class="num">23.44°</text>
    <text x="96" y="122">equator</text>
  </g>

  <g data-layer="5">
    <path class="d thin" d={`M${X0} ${YB} H${X1}`} pathLength="1" />
    <path class="d thin" d={`M${r2(xOf(172))} ${YB} V${YB - 34}`} pathLength="1" />
    <path class="d" d={curve(172, 14)} pathLength="1" />
    <path class="d dash" d={curve(202, 10)} />
    <path class="d dot" d={curve(232, 7)} />
    {months.map((m, i) => <text x={r2(X0 + ((X1 - X0) / 12) * (i + 0.5))} y="327" text-anchor="middle" class="month">{m}</text>)}
    <path class="d" d="M24 346 H44" pathLength="1" />
    <text x="50" y="350">sunlight</text>
    <path class="d dash" d="M128 346 H148" />
    <text x="154" y="350">land: ≈1 month later</text>
    <path class="d dot" d="M24 362 H44" />
    <text x="50" y="366">ocean: ≈2 months later</text>
  </g>
</svg>
