---
import Signup from './Signup.astro';
import ArchFigure from './ArchFigure.astro';
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title" data-sheet="hero">
  <div class="grid">
    <h1 id="hero-title" class="display h1 c-wide hero-title">
      {site.headline.split(' ').map((w, i, all) => (
        <Fragment><span class="w" style={`--i:${i}`}>{w}</span>{i < all.length - 1 ? ' ' : ''}</Fragment>
      ))}
    </h1>

    <p class="lede c-text hero-lede">
      Anybody Is Genius is an AI teacher for adults. A few quick questions find what you already
      know. Then it teaches just past that, a little each day, and brings ideas back until they
      stick.
    </p>

    <div class="row hero-form">
      <div class="c-text"><Signup id="email-top" /></div>
      <p class="note c-note hero-note">
        Below, in Fig. 1: one question answered at five levels, from a child’s explanation to an
        expert’s.
      </p>
    </div>

    <div class="hero-fig"><ArchFigure kind="hero" /></div>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--u) * 6); padding-bottom: calc(var(--u) * 10); }
  @media (min-width: 1024px) { .hero { padding-top: calc(var(--u) * 15); padding-bottom: calc(var(--u) * 14); } }
  @media (max-height: 640px), (max-width: 340px) {
    .hero { padding-top: calc(var(--u) * 3); }
    .hero-lede { margin-top: calc(var(--u) * 2); }
    .hero-form { margin-top: calc(var(--u) * 3); }
  }
  .hero-title { font-feature-settings: 'lnum'; }

  /* entrance: words set one after another, then the lede and form settle */
  :global(html.motion) .hero-title .w {
    display: inline-block;
    animation: set 1.15s var(--resolve) both;
    animation-delay: calc(60ms + var(--i) * 75ms);
  }
  :global(html.motion) .hero-lede { animation: settle 1s var(--resolve) 0.42s both; }
  :global(html.motion) .hero-form { animation: settle 1s var(--resolve) 0.56s both; }
  @keyframes set {
    from { opacity: 0; transform: translateY(0.34em) rotate(0.6deg); }
  }
  @keyframes settle {
    from { opacity: 0; transform: translateY(12px); }
  }
  .hero-lede { margin-top: calc(var(--u) * 3); }
  @media (min-width: 1024px) { .hero-lede { margin-top: calc(var(--u) * 4); } }
  .hero-form { margin-top: calc(var(--u) * 4); }
  @media (min-width: 1024px) { .hero-form { margin-top: calc(var(--u) * 6); } }
  .hero-note { align-self: start; padding-top: 2px; }

  /* the circle beside the headline: wide screens only, in the note column,
     never behind text */
  .hero-fig { display: none; }
  @media (min-width: 1200px) {
    .hero-title { grid-column: text; }
    .hero-fig {
      display: block;
      grid-column: note;
      grid-row: 1 / span 2;
      align-self: center;
      justify-self: end;
      width: 100%;
      max-width: 280px;
    }
  }
</style>
