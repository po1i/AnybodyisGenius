---
const steps = [
  {
    title: 'Find your level',
    body: 'A few quick questions show what you already know, and where it starts to get shaky. It takes minutes, not a placement exam.',
  },
  {
    title: 'Work just past it',
    body: 'Each session starts on solid ground and goes one step further. You predict, answer and explain, so the thinking is yours, and the teaching adjusts as you go.',
  },
  {
    title: 'Make it stick',
    body: 'Ideas come back over the following days and weeks, spaced out so you have to recall them. What you can recall without looking is what you keep.',
  },
];
---
<section class="section how" aria-labelledby="how-title">
  <div class="grid">
    <div class="section-rule"></div>
    <h2 id="how-title" class="display h2 c-text" data-reveal>How it teaches</h2>

    <ol class="steps c-text" data-reveal-group>
      {steps.map((s, i) => (
        <li class="step" data-reveal>
          <span class="step-n ui" aria-hidden="true">{i + 1}</span>
          <div>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <figure class="fig2 c-note" data-fig2 data-reveal>
      <div class="f2-wrap">
        <svg viewBox="0 0 280 120" aria-hidden="true" focusable="false" data-f2-svg>
          <path class="f2-known draw" d="M8 62 H130" pathLength="1" data-f2-known />
          <path class="draw" d="M8 56 V68" pathLength="1" />
          <g data-f2-band style="transform: translateX(130px)">
            <path class="dotted" d="M58 62 H264" />
            <path class="draw" d="M6 46 V78 M6 46 H12 M6 78 H12 M50 46 V78 M50 46 H44 M50 78 H44" pathLength="1" />
            <text x="28" y="36" text-anchor="middle" class="lbl">where teaching happens</text>
          </g>
          <circle class="f2-knob" cx="130" cy="62" r="5" data-f2-knob />
          <text x="8" y="94" class="lbl">what you know</text>
        </svg>
        <input
          class="f2-range"
          type="range"
          min="20"
          max="72"
          step="1"
          value="44"
          aria-label="How much you already know"
          aria-describedby="fig2-cap"
          data-f2-range
        />
      </div>
      <figcaption class="note" id="fig2-cap">
        <span class="smallcaps fig-n">Fig. 2.</span> Teaching happens just past what you already know.
        The edge moves as you learn. <span class="f2-hint">Drag the edge to try it.</span> Schematic.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .steps { display: grid; gap: calc(var(--u) * 4); margin-top: calc(var(--u) * 5); counter-reset: none; }
  .step { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0 12px; align-items: baseline; max-width: 33em; }
  .step-n {
    font-size: var(--s-14);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--graphite);
    border-top: 1px solid var(--ink);
    padding-top: 4px;
    width: 1.5rem;
    line-height: 21px;
  }
  .step-title { font-family: var(--f-display); font-size: var(--s-24); line-height: calc(var(--u) * 4); text-wrap: balance; }
  .step-body { margin-top: calc(var(--u) * 1); text-wrap: pretty; }

  .fig2 { margin-top: calc(var(--u) * 5); align-self: start; max-width: 320px; }
  @media (min-width: 1200px) { .fig2 { grid-row: 3; margin-top: calc(var(--u) * 5); } }
  @media (max-width: 1199px) { .fig2 { grid-column: text; } }
  .f2-wrap { position: relative; touch-action: pan-y; -webkit-user-select: none; user-select: none; }
  .fig2 svg { width: 100%; height: auto; overflow: visible; }
  .fig2 path { fill: none; stroke: var(--ink); stroke-width: 1.25; vector-effect: non-scaling-stroke; }
  .fig2 .dotted { stroke-dasharray: 2 4; stroke: var(--control); }
  .fig2 .lbl { font-family: var(--f-text); font-style: italic; font-size: 13px; fill: var(--graphite); }
  .f2-knob { fill: var(--paper); stroke: var(--ink); stroke-width: 1.25; vector-effect: non-scaling-stroke; cursor: grab; transition: r 0.2s var(--resolve); }
  .f2-wrap:hover .f2-knob { r: 6.5; }
  .f2-range {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; margin: 0; cursor: grab;
  }
  .f2-range:focus-visible + * { outline: none; }
  .f2-wrap:has(.f2-range:focus-visible) { outline: 2px solid var(--ink); outline-offset: 6px; border-radius: 2px; }
  .f2-wrap:has(.f2-range:active) .f2-knob { r: 7; }
  .fig2 figcaption { margin-top: calc(var(--u) * 2); }
  .fig-n { font-style: normal; color: var(--ink); }
  .f2-hint { display: none; }
  :global(html.js) .f2-hint { display: inline; }
  @media (forced-colors: active) { .fig2 path { stroke: CanvasText; } .fig2 .dotted { stroke: GrayText; } .fig2 .lbl { fill: CanvasText; } .f2-knob { fill: Canvas; stroke: CanvasText; } }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .fig2 .draw:not(.dotted) { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.2s var(--draw); }
    :global(html.js) .fig2 [data-f2-band] .draw { transition-delay: 0.9s; }
    :global(html.js) .fig2.is-drawn .draw:not(.dotted) { stroke-dashoffset: 0; }
  }
</style>
