---
import Signup from './Signup.astro';
---
<button class="pill ui" type="button" aria-haspopup="dialog" aria-controls="join" data-pill hidden>
  <span class="pill-ribbon" aria-hidden="true"></span>
  Join early access
</button>

<dialog class="join" id="join" aria-labelledby="join-title" data-join data-lenis-prevent>
  <div class="join-panel" data-join-panel>
    <div class="join-grab" data-join-grab aria-hidden="true"><span></span></div>
    <button class="join-close" type="button" aria-label="Close" data-join-close>
      <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" /></svg>
    </button>
    <p class="join-mark smallcaps">Early access</p>
    <h2 id="join-title" class="display join-title">Get the first invitations.</h2>
    <p class="join-lede">Add your email and we’ll write when your invitation is ready.</p>
    <div class="join-form"><Signup id="email-modal" autofocus /></div>
  </div>
</dialog>

<style>
  /* the floating pill */
  .pill {
    position: fixed;
    z-index: 20;
    right: max(24px, env(safe-area-inset-right, 0px) + 16px);
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 22px 0 18px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--ink);
    color: var(--leaf);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    cursor: pointer;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08) inset, 0 10px 30px -8px rgb(28 27 24 / 0.45), 0 2px 6px rgb(28 27 24 / 0.18);
    opacity: 0;
    transform: translateY(18px) scale(0.98);
    pointer-events: none;
    transition: opacity 0.35s var(--depart), transform 0.45s var(--depart), background-color 0.15s linear;
  }
  .pill:global(.is-shown) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 0.6s var(--resolve), transform 0.8s var(--resolve), background-color 0.15s linear;
  }
  .pill:hover { background: var(--ink-hover); }
  .pill:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .pill-ribbon {
    width: 7px;
    height: 14px;
    background: var(--rubric);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 76%, 0 100%);
    transform: translateY(1px);
  }
  @media (max-width: 639px) {
    .pill { right: auto; left: 50%; translate: -50% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill, .pill:global(.is-shown) { transform: none; transition: opacity 0.2s linear; }
  }

  /* the dialog: centered card on wide screens, bottom sheet on phones */
  .join {
    width: min(100% - 32px, 34rem);
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
    opacity: 0;
    transform: translateY(14px) scale(0.985);
  }
  .join[open] {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s var(--resolve),
      transform 0.65s var(--resolve),
      overlay 0.65s allow-discrete,
      display 0.65s allow-discrete;
  }
  @starting-style {
    .join[open] { opacity: 0; transform: translateY(14px) scale(0.985); }
  }
  .join::backdrop {
    background: rgb(247 244 238 / 0);
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
  }
  .join[open]::backdrop {
    transition: background-color 0.35s linear, backdrop-filter 0.35s linear;
    background: rgb(247 244 238 / 0.62);
    -webkit-backdrop-filter: blur(6px) saturate(0.9);
    backdrop-filter: blur(6px) saturate(0.9);
  }
  @starting-style {
    .join[open]::backdrop { background: rgb(247 244 238 / 0); backdrop-filter: blur(0); }
  }
  .join:global(.vt-morph), .join:global(.vt-morph)::backdrop { transition: none !important; }

  .join-panel {
    position: relative;
    padding: 36px 32px 30px;
    background: var(--leaf);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    box-shadow: 0 40px 90px -30px rgb(28 27 24 / 0.38), 0 8px 24px -12px rgb(28 27 24 / 0.2);
    overflow: auto;
    max-height: inherit;
    overscroll-behavior: contain;
  }
  .join-grab { display: none; }
  .join-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--graphite);
    cursor: pointer;
    transition: background-color 0.15s linear, color 0.15s linear;
  }
  .join-close:hover { background: rgb(28 27 24 / 0.06); color: var(--ink); }
  .join-close:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .join-close svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .join-mark { color: var(--graphite); font-size: var(--s-14); }
  .join-title { margin-top: 8px; font-size: var(--s-36); line-height: 42px; max-width: 14ch; }
  .join-lede { margin-top: 12px; color: var(--graphite); font-size: var(--s-18); line-height: 28px; max-width: 28em; }
  .join-form { margin-top: 24px; }

  @media (max-width: 639px) {
    .join {
      width: 100%;
      max-height: calc(100dvh - 24px);
      margin: auto 0 0;
      transform: translateY(100%);
    }
    .join[open] { transform: none; }
    @starting-style { .join[open] { transform: translateY(100%); } }
    .join-panel {
      padding: 10px 20px calc(24px + env(safe-area-inset-bottom, 0px));
      border-radius: 16px 16px 0 0;
      border-bottom: 0;
    }
    .join-grab { display: grid; place-items: center; height: 28px; touch-action: none; cursor: grab; }
    .join-grab span { width: 40px; height: 4px; border-radius: 4px; background: var(--hairline); }
    .join-close { top: 8px; right: 8px; }
    .join-title { font-size: var(--s-24); line-height: 32px; margin-top: 6px; }
    .join-lede { font-size: var(--s-16); line-height: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .join, .join[open] { transform: none; }
    @starting-style { .join[open] { transform: none; } }
  }
  @media (forced-colors: active) {
    .pill { border-color: ButtonText; }
    .join-panel { border: 1px solid CanvasText; }
  }

  /* morph between the pill and the panel (View Transitions) */
  :global(::view-transition-group(join)) { animation-duration: 0.42s; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
  :global(::view-transition-old(join)) { animation: 0.18s linear both vt-fade-out; height: 100%; object-fit: none; overflow: clip; }
  :global(::view-transition-new(join)) { animation: 0.3s linear 0.1s both vt-fade-in; height: 100%; object-fit: none; overflow: clip; object-position: 50% 0; }
  @keyframes vt-fade-out { to { opacity: 0; } }
  @keyframes vt-fade-in { from { opacity: 0; } }
</style>
