---
import Placeholder from './Placeholder.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<header class="masthead">
  <div class="grid">
    <div class="mast-row c-full">
      <p class="wordmark">
        {site.logo ? <img src={`${base}${site.logo}`} alt="" height="20" /> : null}
        <span class="smallcaps">{site.name}</span>
        {!site.logo && <Placeholder label="logo" />}
      </p>
      <p class="mast-date smallcaps">
        Early access opens {site.launchDate ?? <Placeholder label="launch date" />}
      </p>
    </div>
  </div>
</header>

<style>
  .masthead { padding-top: calc(var(--u) * 4); }
  @media (max-height: 640px) { .masthead { padding-top: calc(var(--u) * 2); } }
  .mast-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: calc(var(--u) * 2);
    border-bottom: 1px solid var(--hairline);
    font-size: var(--s-16);
    line-height: calc(var(--u) * 3);
  }
  .wordmark { display: flex; flex-wrap: nowrap; align-items: baseline; gap: 10px; min-width: 0; white-space: nowrap; }
  .wordmark :global(.ph) { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .wordmark img { align-self: center; }
  .wordmark .smallcaps { font-size: 1.05em; letter-spacing: 0.08em; }
  .mast-date { color: var(--graphite); text-align: right; white-space: nowrap; }
  @media (max-width: 767px) { .mast-date { display: none; } }
</style>
