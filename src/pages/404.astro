---
// GitHub Pages serves this for any address under the site that doesn't exist.
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<Base title={`Page not found: ${site.name}`} noindex>
  <Masthead />
  <main id="main" class="section nf">
    <div class="grid">
      <p class="mark smallcaps nf-mark">404</p>
      <h1 class="display h2 c-text">This page isn’t here.</h1>
      <p class="lede c-text nf-lede">
        The link may be old or mistyped. Everything about early access is on the home page.
      </p>
      <p class="c-text nf-go"><a class="nf-btn ui" href={base}>Back to {site.name}</a></p>
    </div>
  </main>
  <Colophon />
</Base>

<style>
  .nf { min-height: 60vh; }
  .nf-mark { color: var(--ink); }
  .nf-lede { margin-top: calc(var(--u) * 2); }
  .nf-go { margin-top: calc(var(--u) * 5); }
  .nf-btn {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: 2px;
    background: var(--ink);
    color: var(--leaf);
    font-size: var(--s-16);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.12s linear;
  }
  .nf-btn:hover { background: var(--ink-hover); }
</style>
